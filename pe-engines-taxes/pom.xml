<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.threevictors.aws.priceeye.exp</groupId>
    <artifactId>pe-engines-taxes</artifactId>
    <version>0.01-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>pe-engines-taxes</name>

    <url>http://www.3victors.com</url>

    <properties>
        <!--suppress UnresolvedMavenProperty -->
        <resources.resource.directory>${maven.multiModuleProjectDirectory}/resources/</resources.resource.directory>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <version.priceeyev2>0.113</version.priceeyev2>

        <!-- greater than version 3.1 maven required -->
        <version.plugin.enforcer>3.4.1</version.plugin.enforcer>
        <version.plugin.enforcer.enforce>(3.1,)</version.plugin.enforcer.enforce>
        <version.velocity>2.4</version.velocity>
        <version.soap>1.4.0</version.soap>
        <version.json-path>2.9.0</version.json-path>
        <version.slf4j>2.0.16</version.slf4j>
        <version.amazon.aws.sdk.v2>2.30.30</version.amazon.aws.sdk.v2>
        <version.mysql.connector>9.2.0</version.mysql.connector>


        <git.directory>~/git</git.directory>
        <docker.pushRegistry>732267085676.dkr.ecr.us-east-1.amazonaws.com</docker.pushRegistry>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.release>11</maven.compiler.release>
        <maven.compiler.verbose>false</maven.compiler.verbose>
        <maven.compiler.debug>false</maven.compiler.debug>
        <maven.compiler.showDeprecation>false</maven.compiler.showDeprecation>
        <maven.compiler.showWarnings>false</maven.compiler.showWarnings>
        <maven.build.timestamp.format>yyyyMMdd_HHmm</maven.build.timestamp.format>
        <buildNumber>${maven.build.timestamp}</buildNumber>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>

        <minimize.resources>false</minimize.resources>
    </properties>

    <!--.
    - Used to **upload/deploy** your project artifacts
    - Specifies where Maven should deploy your project's artifacts
    - Acts as a destination for your built artifacts
    - Used during the `mvn deploy` phase
    -->
    <distributionManagement>
        <repository>
            <id>atpco-3v-3V-ATP</id>
            <name>atpco-3v-3V-ATP</name>
            <url>https://atpco-3v-590183652635.d.codeartifact.us-east-1.amazonaws.com/maven/3V-ATP/</url>
        </repository>
    </distributionManagement>


    <scm>
        <connection>scm:git:git@github.com:atp1pxj/pe-engines-taxes-exp.git</connection>
        <url>scm:git:git@github.com:atp1pxj/pe-engines-taxes-exp.git</url>
        <developerConnection>scm:git:git@github.com:atp1pxj/pe-engines-taxes-exp</developerConnection>
        <tag>HEAD</tag>
    </scm>


    <!--
        - Used to **download** dependencies and artifacts
        - Specifies where Maven should look for dependencies
        - Acts as a source for getting required libraries
        - Used during the build process when Maven needs to resolve dependencies
    -->
    <repositories>
        <!-- repo config for priceeye related artifacts-->
        <repository>
            <id>atpco-3v-3V-ATP</id>
            <name>atpco-3v-3V-ATP</name>
            <url>https://atpco-3v-590183652635.d.codeartifact.us-east-1.amazonaws.com/maven/3V-ATP/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <!-- repo config for Engine related artifacts-->
        <repository>
            <id>Nexus</id>
            <name>ATPCO Nexus Maven Repository</name>
            <url>http://artmgt01.atpco.org:8081/repository/maven-public/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>Maven_Central</id>
            <name>ATPCO Nexus Maven Central Repository</name>
            <url>http://artmgt01.atpco.org:8081/repository/maven-central/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>Nexus_RandD</id>
            <name>ATPCO Nexus Maven Repository</name>
            <url>http://artmgt01.atpco.org:8081/repository/maven-releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>



    <build>
        <resources>
            <!-- globally include log4j2.xml configuration -->
            <resource>
                <directory>${resources.resource.directory}</directory>
                <includes>
                    <include>log4j2.xml</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <!-- reinstate resources plugin default behavior -->
            <resource>
                <directory>${project.basedir}/src/main/resources/</directory>
                <includes>
                    <include>*</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.amashchenko.maven.plugin</groupId>
                    <artifactId>gitflow-maven-plugin</artifactId>
                    <configuration>
                        <pushRemote>false</pushRemote>
                        <commitMessagePrefix>[maven-gitflow]</commitMessagePrefix>
                        <gitFlowConfig>
                            <productionBranch>master</productionBranch>
                            <developmentBranch>develop</developmentBranch>
                            <featureBranchPrefix>feature/</featureBranchPrefix>
                            <releaseBranchPrefix>release/</releaseBranchPrefix>
                            <hotfixBranchPrefix>hotfix/</hotfixBranchPrefix>
                            <versionTagPrefix>${project.artifactId}-</versionTagPrefix>
                        </gitFlowConfig>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <!-- newer versions of this plugin break lambda logging and other stuff... -Donnie -->
                    <version>2.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>jaxb2-maven-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.3.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.12.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                    <configuration>
                        <archive>
                            <index>true</index>
                            <manifest>
                                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                            <manifestEntries>
                                <Implementation-URL>${project.url}</Implementation-URL>
                                <Java-Version>${java.version}</Java-Version>
                                <Java-Vendor>${java.vendor}</Java-Vendor>
                                <Os-Name>${os.name}</Os-Name>
                                <Os-Arch>${os.arch}</Os-Arch>
                                <Os-Version>${os.version}</Os-Version>
                                <Scm-Url>${project.scm.url}</Scm-Url>
                                <Scm-Connection>${project.scm.connection}</Scm-Connection>
                                <Scm-Revision>${buildNumber}</Scm-Revision>
                                <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                                <!-- NOTE: this did not work to get rid of this message on open jdk 9+
                                WARNING: sun.reflect.Reflection.getCallerClass is not supported. This will impact performance.
                                <Multi-Release>true</Multi-Release>

                                if we really care, which I don't think we do, we would have to upgrade the jar plugin
                                and maybe do other work to get rid of this warning on open jdk 9+.  I think the warning
                                is only saying that looking up stack traces in log4j could be slower b/c it uses reflection
                                instead of some new, faster way in the newly java 9+ packaged multi-release jar... -Donnie 20210319
                                -->
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>cobertura-maven-plugin</artifactId>
                    <version>2.7</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-ejb-plugin</artifactId>
                    <version>2.5.1</version>
                    <configuration>
                        <filterDeploymentDescriptor>true</filterDeploymentDescriptor>
                        <ejbVersion>3.1</ejbVersion>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.0.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.0.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.2.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${version.plugin.enforcer}</version>
                    <executions>
                        <execution>
                            <id>enforce-maven</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>${version.plugin.enforcer.enforce}</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>0.43.4</version>
                    <extensions>true</extensions>
                    <configuration>
                        <pushRegistry>${docker.pushRegistry}</pushRegistry>
                        <logStdout>true</logStdout>
                        <verbose>all</verbose>
                        <!--                        Set useColor to false to get it to log script output.-->
                        <!--                        <useColor>false</useColor>-->
                        <skip>true</skip>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.amazonaws</groupId>
                            <artifactId>aws-java-sdk-core</artifactId>
                            <version>1.11.707</version>
                        </dependency>
                        <!--                        <dependency>
                                                    <groupId>software.amazon.awssdk</groupId>
                                                    <artifactId>auth</artifactId>
                                                    <version>${version.amazon.aws.sdk.v2}</version>
                                                </dependency>-->
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>create-repo</id>
                            <phase>deploy</phase>
                            <goals>
                                <goal>exec</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <executable>echo</executable>
                        <arguments>
                            <argument>Not running.</argument>
                        </arguments>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.1</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>



    <dependencies>
        <!-- Pull the priceeye-data module (jar type) from maven repo. Not priceeye parent (pom type)-->
        <dependency>
            <groupId>com.threevictors.aws.priceeye</groupId>
